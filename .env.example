# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# Never commit real values. All of these are read on the server only.

# --- Supabase (simulated SAP data source + app records) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_…) or legacy service_role key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, only for `npm run db:migrate` (Supabase → Connect → Session pooler URI)
DATABASE_URL=
# Name recorded on runs, approvals and POs. There is no sign-in.
PLANNER_NAME=Demand Planner

# --- Zoho Inventory (server only; connected once by the account owner) ---
# Your Zoho data centre: the domain you sign in with (.com, .in, .eu, .com.au, …)
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
# api-console.zoho.<dc> → Add Client → Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Set by: npm run zoho:token -- <code from Self Client → Generate Code>
ZOHO_REFRESH_TOKEN=
# Only needed if the Zoho account has more than one organisation
ZOHO_ORGANIZATION_ID=
