# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# Never commit real values. All of these are read on the server only.

# --- Supabase (simulated SAP data source + app records) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_…) or legacy service_role key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, only for `npm run db:migrate` (Supabase → Connect → Session pooler URI)
DATABASE_URL=
# Name recorded on runs, approvals and POs. There is no sign-in.
PLANNER_NAME=Demand Planner

# --- Zoho Inventory (server only) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Zoho API Console
ZOHO_REDIRECT_URI=http://localhost:3001/api/zoho/callback
# Region of your Zoho account: .in (India), .com (US), .eu, .com.au, …
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
# 32 random bytes, base64: openssl rand -base64 32  (encrypts stored OAuth tokens)
ZOHO_TOKEN_ENCRYPTION_KEY=
